# === Si Lestari — Environment Variables ===
# Copy file ini menjadi .env.local, lalu isi nilai yang sesuai.

# --- Google Gemini API (server-side ONLY, tidak boleh diekspos ke klien) ---
# Dapatkan di https://aistudio.google.com/apikey (atau aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model: gemini-2.0-flash sudah retired; default kode sekarang gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# --- PocketBase ---
# URL publik untuk akses dari klien (browser)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Kredensial admin untuk operasi server-side (mis. auto-update record hasil AI)
POCKETBASE_ADMIN_EMAIL=admin@silestari.id
POCKETBASE_ADMIN_PASSWORD=
# Model fallback validasi + model khusus chat (kuota free tier dihitung per model/hari)
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODEL_CHAT=gemini-3.5-flash-lite
